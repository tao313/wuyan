[Script]
http-request ^https?:\/\/i\.tlq520\.cn\/ultra\/api\/v1\/device\/register script-path=https://raw.githubusercontent.com/tao313/wuyan/main/unlock.js, requires-body=true, timeout=15, tag=无感刷卡助手激活
http-response ^https?:\/\/i\.tlq520\.cn\/(ultra\/api\/v1\/app\/record\/device|geofence\/api\/subscription\/device-authorization|geofence\/api\/subscriber\/my-subscriptions) script-path=https://raw.githubusercontent.com/tao313/wuyan/main/unlock.js, requires-body=true, timeout=15, tag=无感刷卡助手解锁

[MITM]
hostname = i.tlq520.cn, ultra.tlq520.cn, *.tlq520.cn
